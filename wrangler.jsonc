{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "best-palitan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist/best-palitan/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "browser": {
    "binding": "BROWSER"
  }
}
